# PayPal Sandbox Credentials
# Keep mock mode enabled for a credential-free, deterministic hackathon demo.
PAYPAL_MOCK_MODE=true
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Gemini (free-tier key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# App
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://pactra.onrender.com

# Database
DATABASE_URL=sqlite:///./pactra.db

# Policy config path, resolved from the repository root
POLICY_CONFIG_PATH=./backend/policy.json

# Frontend build-time API URL. Leave blank locally to use Vite's proxy.
VITE_API_URL=
