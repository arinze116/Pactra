# Local development defaults. Never place live credentials in this file.
APP_ENV=development
SECRET_KEY=generate-a-random-secret-at-least-32-bytes
# Production may use an absolute 0600 file instead of putting the secret here.
SECRET_KEY_FILE=
DATABASE_URL=sqlite:///./pactra.db

BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
AUTH_REGISTRATION_RATE_LIMIT_PER_HOUR=10

AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=12
MAX_CHAT_HISTORY=20

PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TEST_RECIPIENT_EMAIL=
PAYPAL_MOCK_MODE=false
PAYPAL_REQUEST_TIMEOUT_SECONDS=15

# Leave blank locally to use Vite's /api proxy.
VITE_API_URL=
POLICY_CONFIG_PATH=./backend/policy.json
SEED_DEMO_ACCOUNT=false
