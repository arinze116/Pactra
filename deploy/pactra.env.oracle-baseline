# Safe loopback-only production baseline. Replace both localhost origins with
# verified HTTPS frontend/API origins before exposing Pactra through Nginx.
APP_ENV=production
SECRET_KEY_FILE=/etc/pactra/secret-key
DATABASE_URL=postgresql+psycopg:///pactra

BACKEND_URL=https://localhost
FRONTEND_URL=https://localhost
CORS_ORIGINS=https://localhost
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
AUTH_REGISTRATION_RATE_LIMIT_PER_HOUR=10
AUTH_REGISTRATION_GLOBAL_RATE_LIMIT_PER_HOUR=100
AUTH_LOGIN_GLOBAL_RATE_LIMIT_PER_MINUTE=30

AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_SECONDS=12
GEMINI_REQUEST_ATTEMPTS=2
MAX_CHAT_HISTORY=20

PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TEST_RECIPIENT_EMAIL=
PAYPAL_MOCK_MODE=false
PAYPAL_REQUEST_TIMEOUT_SECONDS=15

POLICY_CONFIG_PATH=./backend/policy.json
SEED_DEMO_ACCOUNT=false
