{
  "name": "pactra-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "npm run test:e2e:journeys && npm run test:e2e:accessibility",
    "test:e2e:journeys": "playwright test tests/e2e/judge-flow.spec.ts tests/e2e/public-experience.spec.ts tests/e2e/navigation-regressions.spec.ts",
    "test:e2e:accessibility": "playwright test tests/e2e/accessibility.spec.ts",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:e2e:public": "playwright test --config playwright.public.config.ts",
    "test:lighthouse:assert": "node scripts/assert-lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "ag-grid-community": "31.3.4",
    "ag-grid-react": "31.3.4",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "lighthouse": "^13.6.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
